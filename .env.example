APP_ENV=development
LOG_LEVEL=INFO

AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5

# Google Maps Platform: enable Places API (New), restrict this key to server-side use.
BUSINESS_DATA_API_KEY=
# Alternative variable name accepted by the backend:
GOOGLE_MAPS_API_KEY=

# Use a strong private value in the hosted environment; never commit it.
APP_API_TOKEN=

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Use managed persistent storage before storing business-critical records.
GROWTH_ENGINE_DATA_PATH=data/runtime_store.json
# Business operations use the same APP_API_TOKEN as the existing swarm API.
BUSINESS_DB_PATH=data/business.sqlite3
# Set true only when the DB path is on an actual persistent volume.
BUSINESS_DURABLE_STORAGE=false
# Optional server-side read-only Shopify sync. Never put these values in HTML.
SHOPIFY_STORE_DOMAIN=greenifyhomeandgarden.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Separate token accepted only by the Rillmark aggregate-report bridge.
POLSIA_BRIDGE_TOKEN=
